# OMNIFORGE configuration — dummy values only. NEVER commit real credentials.
# Copy to .env and fill locally, or inject via your secret manager.

# --- Free-first operating economics (defaults; do not raise without approval) ---
FREE_FIRST_MODE=true
AUTO_PROVISION_PAID=false
APPROVED_SPEND=0

# --- Optional model providers (leave empty to run fully deterministic/local) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Optional integrations ---
# GitHub token used BY YOU for your own repositories; never required for local generation.
GITHUB_TOKEN=
# Context7 documentation retrieval (optional, hosted service with its own terms)
CONTEXT7_API_KEY=

# --- Local paths ---
OMNIFORGE_HOME=

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sample Notes",
  "version": "0.1.0",
  "identifier": "com.example.samplenotes",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [
      { "title": "Sample Notes", "width": 900, "height": 640, "resizable": true }

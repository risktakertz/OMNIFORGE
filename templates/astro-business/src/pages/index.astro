---
import Base from "../layouts/Base.astro";

const services = [
  { name: "Consultation", description: "Tell us what you need; we recommend the right option." },
  { name: "Delivery", description: "Fast, careful delivery across the service area." },
  { name: "Support", description: "Honest advice before and after you buy." },
];
---
<Base title="Sample Studio — Astro site" description="Original Astro business starter generated by OMNIFORGE.">
  <main id="main" style="max-width:760px;margin:0 auto;padding:48px 16px;">
    <h1 style="color:#0f766e;">Sample Studio</h1>
    <p><strong>Content-rich business site starter.</strong> Astro ships zero JS by default — ideal for SEO-first local business sites. Extend with collections, MDX content and the OMNIFORGE i18n pack as needed.</p>
    <section aria-labelledby="svc">
      <h2 id="svc">Services</h2>
      <ul style="list-style:none;padding:0;">
        {services.map((s) => (
          <li style="background:#fff;border:1px solid #e7e5e4;border-radius:12px;padding:14px;margin-bottom:10px;">
            <h3 style="margin:0 0 4px;">{s.name}</h3>
            <p style="margin:0;color:#57534e;">{s.description}</p>
          </li>
        ))}
      </ul>
    </section>
    <p><a href="mailto:hello@example.com">Contact us</a></p>
  </main>
</Base>

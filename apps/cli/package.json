{
  "name": "@omniforge/cli",
  "private": true,
  "version": "0.1.0",
  "description": "omniforge — the user-facing CLI for planning, creating, verifying and exporting software.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "omniforge": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@omniforge/shared-types": "workspace:*",
    "@omniforge/utils": "workspace:*",
    "@omniforge/observability": "workspace:*",
    "@omniforge/intent-engine": "workspace:*",
    "@omniforge/blueprint-engine": "workspace:*",
    "@omniforge/capability-registry": "workspace:*",
    "@omniforge/skill-router": "workspace:*",
    "@omniforge/task-planner": "workspace:*",
    "@omniforge/tool-gateway": "workspace:*",
    "@omniforge/workspace-manager": "workspace:*",
    "@omniforge/verification": "workspace:*",
    "@omniforge/model-router": "workspace:*",
    "@omniforge/orchestration": "workspace:*",
    "@omniforge/deployment": "workspace:*",
    "@omniforge/research-engine": "workspace:*",
    "@omniforge/agent-runtime": "workspace:*",
    "yaml": "^2.7.0"
  }
